# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# =============================================================================
# Auto-Connect Google Apps Script & Google Spreadsheet (Netlify / Cloud Run)
# Set these in Netlify -> Site configuration -> Environment variables
# so every deployment connects automatically without manual configuration.
# =============================================================================
APPS_SCRIPT_WEBAPP_URL=""
APPS_SCRIPT_SYNC_SECRET=""
SPREADSHEET_URL=""
SPREADSHEET_ID=""

# Client-side Vite build defaults (optional if server-side APPS_SCRIPT_WEBAPP_URL is set)
VITE_APPS_SCRIPT_WEBAPP_URL=""
VITE_SPREADSHEET_URL=""
VITE_SPREADSHEET_ID=""
VITE_AUTO_SYNC_ENABLED="true"
